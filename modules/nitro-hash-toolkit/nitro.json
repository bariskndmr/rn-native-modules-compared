{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrohashtoolkit"],
  "ios": {
    "iosModuleName": "NitroHashToolkit"
  },
  "android": {
    "androidNamespace": ["nitrohashtoolkit"],
    "androidCxxLibName": "NitroHashToolkit"
  },
  "autolinking": {
    "HashToolkit": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridHashToolkit"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridHashToolkit"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
